# Copy to .env for local development. Never commit the real .env.

FLASK_ENV=development
SERVICE_NAME=vantageridgetech-website
APP_ENV=local
SECRET_KEY=

# ZeptoMail (Zoho's transactional email API) — used for the contact form.
# Get a key from the ZeptoMail dashboard (zeptomail.zoho.com), not Zoho Mail itself.
# Zoho provisions accounts into regional data centers — check your dashboard's URL
# (e.g. zeptomail.zohocloud.ca means Canada) and set the matching API host below.
ZEPTOMAIL_API_URL=https://api.zeptomail.ca/v1.1/email
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_SENDER_EMAIL=hello@vantageridgetech.com
ZEPTOMAIL_SENDER_NAME=Vantage Ridge Technologies
CONTACT_RECIPIENT_EMAIL=hello@vantageridgetech.com

ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5
CHAT_MAX_TOKENS=500
